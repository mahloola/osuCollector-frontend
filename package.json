  "scripts": {
    "start": "cross-env BROWSER=none cross-env GENERATE_SOURCEMAP=false react-scripts start",
    "build": "react-scripts build && rm -rf electron/src/build && mv build electron/src",
    "publish": "react-scripts build && gsutil rsync -r build gs://desktop.osucollector.com && gsutil setmeta -h \"Cache-Control: max-age=0\" gs://desktop.osucollector.com/index.html"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "https://osucollector.com",
  "homepage": "./",
  "devDependencies": {
    "prettier": "^3.5.2"
  },
  "resolutions": {
    "@types/react": "17.0.40"
  }
